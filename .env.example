# ---------------------------------------------------------------------------
# Veris configuration. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
VERIS_DB=data/veris.db
VERIS_DATA_DIR=data

# --- HTTP ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- Authentication --------------------------------------------------------
# When set, every mutating route requires `Authorization: Bearer <token>`.
# Leave empty ONLY for a local demo. Set it for any deployed instance —
# /api/v1/health reports which posture is in effect.
VERIS_API_TOKEN=

# --- Model provider --------------------------------------------------------
# Veris is model-agnostic. Choose one:
#
# 1) Local, on-premises (default). Anything speaking /v1/chat/completions:
#    Ollama, vLLM, LM Studio, llama.cpp server. Knowledge never leaves the
#    building, which for many health systems is the deciding factor.
# VERIS_MODEL_PROVIDER=ollama
# VERIS_MODEL=llama3.1:8b
# VERIS_MODEL_BASE_URL=http://localhost:11434/v1
# VERIS_MODEL_API_KEY=
# VERIS_MODEL_CONTEXT=8192
#
# 2) A hosted OpenAI-compatible endpoint:
# VERIS_MODEL_PROVIDER=openai
# VERIS_MODEL=gpt-4o-mini
# VERIS_MODEL_BASE_URL=https://api.openai.com/v1
# VERIS_MODEL_API_KEY=sk-...
#
# 3) Anthropic:
# VERIS_MODEL_PROVIDER=anthropic
# VERIS_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
#
# 4) Recorded (default). Replays stored responses from VERIS_RECORDINGS.
#    Makes evaluation reproducible without paying for inference, and lets the
#    demo run with no model configured at all.
VERIS_MODEL_PROVIDER=recorded
VERIS_RECORDINGS=data/recordings
